{
  "name": "@vokoma/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "tsx src/main.ts api",
    "start": "node dist/main.js",
    "hash-password": "tsx src/main.ts hash-password",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "openapi": "tsx src/openapi.ts",
    "openapi:check": "tsx src/openapi.ts --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check && pnpm build"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.4",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
